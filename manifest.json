{
  "manifest_version": 3,
  "name": "Pointer by 021 — show your coding agent exactly what to change",
  "short_name": "Pointer",
  "version": "1.0.0",
  "description": "Pick an element, draw, crop, comment, then paste one picture + its source file:line into Claude Code, Cursor or any AI agent.",
  "homepage_url": "https://021.is/plugins/pointer",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "welcome.html", "open_in_tab": true },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Pointer",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+P", "mac": "Alt+P" },
      "description": "Turn Pointer on or off on this tab"
    }
  }
}
