{
  "manifest_version": 3,
  "name": "Pointer",
  "version": "0.1.0",
  "description": "Draw on a page or pick an element, then copy a small bundle for your coding agent: the picture and where the code lives.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Pointer (Alt+Shift+P)",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P", "mac": "Alt+Shift+P" },
      "description": "Turn Pointer on or off on this tab"
    }
  }
}
